# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
WEB_ORIGIN=http://127.0.0.1:5173
LOG_LEVEL=INFO

# Development identity
AUTH_MODE=dev
DEV_TENANT_ID=00000000-0000-0000-0000-000000000001
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# PostgreSQL / Redis
POSTGRES_PORT=55432
REDIS_PORT=56379
DATABASE_URL=postgresql+psycopg://agentplane:agentplane_dev_2026@127.0.0.1:55432/agentplane
CHECKPOINT_DATABASE_URL=postgresql://agentplane:agentplane_dev_2026@127.0.0.1:55432/agentplane
REDIS_URL=redis://127.0.0.1:56379/0
REDIS_RUN_STREAM=agentplane:runs
REDIS_RUN_GROUP=agentplane-workers

# OpenAI-compatible model endpoint
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_CONCURRENCY=8

# Worker / events
WORKER_CONSUMER_NAME=worker-local-1
WORKER_BLOCK_MS=5000
WORKER_RECLAIM_IDLE_MS=60000
OUTBOX_POLL_SECONDS=0.5
SSE_POLL_SECONDS=1
SSE_KEEPALIVE_SECONDS=15
